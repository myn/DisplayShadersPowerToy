<Window x:Class="DisplayShadersPowerToy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OLED Text Optimizer" 
        Height="650" 
        Width="900"
        ResizeMode="CanResize"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Background="#F8F9FA">

    <!-- Add Developer Menu -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Developer Tools">
                <MenuItem Click="ForceEjectDlls_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" 
                                      Foreground="#FF9800" 
                                      FontWeight="Bold" 
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="Force Eject All DLLs"/>
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <Run FontWeight="Bold" Text="WARNING: May crash applications!"/>
                                <LineBreak/>
                                <Run Text="Use only when rebuilding or deleting DLL files."/>
                            </TextBlock>
                        </ToolTip>
                    </MenuItem.ToolTip>
                </MenuItem>
                <Separator/>
                <MenuItem Header="View Logs" Click="ViewLog_Click"/>
                <MenuItem Header="Open Log Folder" Click="OpenLogFolder_Click"/>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="Primary" Color="#0066FF"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#0052CC"/>
        <SolidColorBrush x:Key="Success" Color="#00C853"/>
        <SolidColorBrush x:Key="Warning" Color="#FF9800"/>
        <SolidColorBrush x:Key="Danger" Color="#F44336"/>
        <SolidColorBrush x:Key="Background" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Border" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>
        <SolidColorBrush x:Key="Accent" Color="#7C4DFF"/>

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ModernToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="BackBorder"
                                    Background="#CCCCCC"
                                    CornerRadius="14"
                                    Width="50"
                                    Height="28"/>
                            <Border x:Name="Thumb"
                                    Background="White"
                                    CornerRadius="12"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="{StaticResource Success}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" Margin="24">
                
                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="OLED Text Optimizer" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Crystal-clear text rendering for modern OLED displays" 
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Quick Status Card -->
                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Success}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" 
                                 Width="32" 
                                 Height="32" 
                                 Fill="#4CAF50"
                                 VerticalAlignment="Center" 
                                 Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtQuickStatus" 
                                       Text="Optimizing 5 applications" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="txtQuickStatusDetail" 
                                       Text="Real-time shader injection active" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ToggleButton x:Name="toggleQuickEnable"
                                         Style="{StaticResource ModernToggle}"
                                         IsChecked="True"
                                         Checked="QuickEnable_Changed"
                                         Unchecked="QuickEnable_Changed"/>
                            <TextBlock x:Name="txtToggleStatus"
                                       Text="ENABLED" 
                                       FontSize="10" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monitor Selection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Select a Display" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Button Content="Identify" 
                                    Click="Identify_Click"
                                    HorizontalAlignment="Right"
                                    Padding="12,4"
                                    Height="28"
                                    FontSize="12"
                                    Background="{StaticResource SurfaceHover}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Border Height="240" Background="#F0F2F5" CornerRadius="8" Margin="0,0,0,16">
                            <ItemsControl x:Name="icMonitors">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}" 
                                                Height="{Binding Height}"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseDown="Monitor_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Primary}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="{Binding Index}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#999999"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        
                    </StackPanel>
                </Border>

                <!-- Display Configuration -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="txtConfigHeader"
                                   Text="Display Configuration"
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Select your display type:" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,12"/>

                        <!-- Display Type Selection -->
                        <StackPanel>
                            <RadioButton x:Name="rbDisplayRgbLcd"
                                        GroupName="DisplayType"
                                        Checked="DisplayType_Changed"
                                        Margin="0,0,0,10">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="Standard LCD / LED Monitor" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Traditional RGB stripe layout" 
                                                  FontSize="11" 
                                                  Foreground="{StaticResource TextSecondary}"
                                                  Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <RadioButton x:Name="rbDisplayWoled"
                                        GroupName="DisplayType"
                                        Checked="DisplayType_Changed"
                                        Margin="0,0,0,10">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="LG WOLED (WRGB)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="LG C/G/B series OLED TVs and monitors" 
                                                  FontSize="11" 
                                                  Foreground="{StaticResource TextSecondary}"
                                                  Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <RadioButton x:Name="rbDisplayQdOled"
                                        GroupName="DisplayType"
                                        Checked="DisplayType_Changed"
                                        Margin="0,0,0,10">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="QD-OLED (RGB Triangular)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Samsung / Alienware QD-OLED monitors" 
                                                  FontSize="11" 
                                                  Foreground="{StaticResource TextSecondary}"
                                                  Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <RadioButton x:Name="rbDisplayPentile"
                                        GroupName="DisplayType"
                                        Checked="DisplayType_Changed">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="PenTile AMOLED" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Most smartphone displays" 
                                                  FontSize="11" 
                                                  Foreground="{StaticResource TextSecondary}"
                                                  Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>

                        <!-- Intensity Slider -->
                        <Border Background="{StaticResource SurfaceHover}" 
                                CornerRadius="6" 
                                Padding="16" 
                                Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Optimization Strength" 
                                              FontSize="13" 
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="txtIntensityValue" 
                                              Text="100%" 
                                              FontSize="13" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource Primary}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sliderIntensity"
                                       Minimum="0"
                                       Maximum="1"
                                       Value="1.0"
                                       TickFrequency="0.1"
                                       IsSnapToTickEnabled="True"
                                       ValueChanged="Intensity_Changed"/>
                                <TextBlock Text="Lower values reduce color fringing but may decrease clarity" 
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondary}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Advanced Options -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Advanced Options" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,16"/>

                        <!-- Injection Mode Toggle -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Real-time Process Injection" 
                                          FontSize="13" 
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically optimize new applications as they launch" 
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondary}"
                                          Margin="0,2,0,0"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <ToggleButton x:Name="toggleAutoInject"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernToggle}"
                                         IsChecked="True"
                                         Checked="AutoInject_Changed"
                                         Unchecked="AutoInject_Changed"
                                         VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ClearType Optimization Toggle -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ClearType Optimization" 
                                          FontSize="13" 
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="Adjust Windows ClearType settings based on display type (fallback mode)" 
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondary}"
                                          Margin="0,2,0,0"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <ToggleButton x:Name="toggleClearType"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernToggle}"
                                         IsChecked="True"
                                         Checked="ClearType_Changed"
                                         Unchecked="ClearType_Changed"
                                         VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,12,0,12"/>

                        <!-- Application Settings -->
                        <CheckBox x:Name="cbStartWithWindows"
                                 Content="Launch automatically at startup"
                                 Checked="StartWithWindows_Changed"
                                 Unchecked="StartWithWindows_Changed"
                                 Margin="0,0,0,8"/>
                        
                        <CheckBox x:Name="cbMinimizeToTray"
                                 Content="Minimize to system tray"
                                 Checked="MinimizeToTray_Changed"
                                 Unchecked="MinimizeToTray_Changed"/>

                        <Separator Margin="0,16,0,16"/>

                        <!-- Reset to Defaults -->
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Reset to Windows Defaults" 
                                              FontSize="13" 
                                              FontWeight="SemiBold"
                                              Foreground="#E65100"/>
                                    <TextBlock Text="Restores standard Windows ClearType settings, disables all optimizations, and clears app settings. Use this to return to the state before running this application." 
                                              FontSize="11"
                                              Foreground="#BF360C"
                                              Margin="0,4,0,0"
                                              TextWrapping="Wrap"
                                              MaxWidth="500"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                       Content="Reset All"
                                       Click="ResetToDefaults_Click"
                                       Height="36"
                                       Padding="20,0"
                                       Margin="16,0,0,0"
                                       Background="#FF5722"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Cursor="Hand"
                                       VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="6"
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E64A19"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Diagnostic Tools -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Diagnostic Tools" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Detailed diagnostic logs are automatically saved" 
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtLogPath" 
                                          Text="Log file location" 
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondary}"
                                          Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                   Content="View Logs"
                                   Click="ViewLog_Click"
                                   Height="36"
                                   Padding="16,0"
                                   Background="{StaticResource SurfaceHover}"
                                   BorderBrush="{StaticResource Border}"
                                   BorderThickness="1"
                                   Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="6"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="3"
                                   Content="Open Folder"
                                   Click="OpenLogFolder_Click"
                                   Height="36"
                                   Padding="16,0"
                                   Background="{StaticResource SurfaceHover}"
                                   BorderBrush="{StaticResource Border}"
                                   BorderThickness="1"
                                   Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="6"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active Processes -->
                <Border Style="{StaticResource Card}" x:Name="borderActiveProcesses" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Optimized Applications" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtProcessCount" 
                                       Text="5 active" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="listActiveProcesses">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceHover}"
                                               CornerRadius="4"
                                               Padding="12,8"
                                               Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" 
                                                      FontSize="11"
                                                      FontFamily="Consolas"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Margin="0,24,0,24">
                    <TextBlock Text="Made for OLED displays" 
                              FontSize="11"
                              Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
